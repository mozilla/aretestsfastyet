{
    "name": "fx-tests",
    "version": "0.0.0",
    "private": true,
    "description": "Command-line access to the Firefox test-health data behind https://tests.firefox.dev/",
    "license": "MPL-2.0",
    "type": "module",
    "bin": {
        "fx-tests": "./bin/fx-tests.js"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "esbuild cli/bin/fx-tests.ts --bundle --platform=node --format=esm --target=node20 --outfile=bin/fx-tests.js --sourcemap --banner:js='#!/usr/bin/env node'",
        "dev": "npm run build -- --watch",
        "typecheck": "tsc --noEmit",
        "test": "node --test test/"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "esbuild": "^0.25.0",
        "typescript": "^5.7.0"
    }
}
