# Why this file exists, given package.json already has a `files` allowlist.
#
# When npm installs from a git URL it packs the checkout itself, and in that
# path it honours .gitignore, and it was dropping the whole of bin/ because the
# generated dev entry point inside it is ignored — so the installed package had
# no binary and the command it linked did not exist, while the same package
# installed from a tarball worked. The shipped bundle now lives in dist/, and
# the presence of this file stops npm consulting .gitignore at all.
#
# Keep it in step with `files` in package.json: this excludes, that includes,
# and the intersection is what ships. `npm pack --dry-run` prints the result.

# Sources: the published package runs the bundle in dist/, not the TypeScript.
cli/
lib/
tools/
test/

# The dashboards, which have nothing to do with the CLI.
*.html
*.css
*.svg
common-*.js
shared.js
fetch-utils.js
dashboards.js
profile-worker.js
fetch-xpcshell-data.js
mochitest-stats-backfill.json

# Development-only configuration.
tsconfig.json
.node-version
.github/
artifacts/

# bin/ holds only the generated development entry point; dist/ is what ships.
bin/
