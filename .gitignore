# Backup files created by editors
*~

# Profile cache directory
profile-cache/

# Test data directory
data/

# Scratch directory for downloaded data files and one-off check scripts
artifacts/

# npm dependencies and the bundler's output (built in CI, never committed).
# Anchored with a leading slash: an unanchored `bin/` also matches cli/bin/,
# which is source.
node_modules/
# `/bin/` cannot be excluded wholesale: git will not re-include a file inside an
# excluded directory, so a `!` for the bundle below would never take effect.
# The generated dev entry point is named instead.
/bin/fx-tests
# The bundle is committed on purpose. Node refuses to strip
# types under node_modules (ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING), so an
# installed package cannot run from .ts, and `prepare` cannot build it either:
# npm runs prepare in a bare cache clone before devDependencies exist. Shipping
# the artefact is what makes `npm i -g github:...` work at all. Rebuild with
# `npm run build`; a stale bundle is caught by tools/check-bundle-fresh.

# V8 profiling logs
isolate-*.log
jit-*.dump
