# Backup files created by editors
*~

# Profile cache directory
profile-cache/

# Test data directory
data/

# Scratch directory for downloaded data files and one-off check scripts
artifacts/

# npm dependencies and the bundler's output (built in CI, never committed).
# Anchored with a leading slash: an unanchored `bin/` also matches cli/bin/,
# which is source.
node_modules/
# bin/ is entirely generated (the dev entry point). The shipped bundle is
# dist/fx-tests.js, which is committed on purpose: Node refuses to strip types
# under node_modules, so an installed package cannot run from .ts, and no
# install hook can build one because npm runs them before devDependencies
# exist. Rebuild with `npm run build`; `npm test` fails on a stale bundle.
/bin/

# V8 profiling logs
isolate-*.log
jit-*.dump
